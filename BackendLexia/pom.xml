<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.sbss.lexia</groupId>
	<artifactId>BackendLexia</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- En Spring Boot 4 la autoconfiguracion se partio en modulos por
		     tecnologia: flyway-core aporta la libreria, spring-boot-flyway es
		     lo que la ejecuta al arrancar. Sin este modulo las migraciones
		     nunca corren y no se emite ningun aviso. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-mysql</artifactId>
		</dependency>

		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Genera getters/setters en tiempo de compilacion. No cambia el
		     bytecode resultante ni el consumo de memoria: solo evita escribir
		     a mano metodos triviales. Es <optional> porque no hace falta en
		     tiempo de ejecucion. -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- JWT. Se usa el serializador Gson y no el de Jackson a proposito:
		     Spring Boot 4 trae Jackson 3 (tools.jackson) y jjwt-jackson espera
		     Jackson 2 (com.fasterxml), lo que daria un fallo en tiempo de
		     ejecucion. Gson es autocontenido y evita ese choque. -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.6</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-gson</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>
				<!-- =========================================================
		     GESTIÓN DOCUMENTAL
		     Se agregan sin modificar las dependencias existentes.
		     ========================================================= -->

		<!-- Leer y generar documentos Word .docx -->
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>5.5.1</version>
		</dependency>

		<!-- Soporte para documentos Word antiguos .doc -->
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-scratchpad</artifactId>
			<version>5.5.1</version>
		</dependency>

		<!-- Lectura y generación de archivos PDF -->
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>pdfbox</artifactId>
			<version>3.0.8</version>
		</dependency>

		<!-- Procesar el HTML generado por el editor de documentos -->
		<dependency>
			<groupId>org.jsoup</groupId>
			<artifactId>jsoup</artifactId>
			<version>1.23.1</version>
		</dependency>

		<!-- Almacenamiento permanente de archivos en un servicio compatible con S3
		     (en produccion, Supabase Storage). Solo el cliente HTTP del JDK:
		     sin Netty ni Apache HttpClient, que pesan y alargan el arranque. -->
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>s3</artifactId>
			<version>2.59.2</version>
			<exclusions>
				<exclusion>
					<groupId>software.amazon.awssdk</groupId>
					<artifactId>netty-nio-client</artifactId>
				</exclusion>
				<exclusion>
					<groupId>software.amazon.awssdk</groupId>
					<artifactId>apache-client</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>url-connection-client</artifactId>
			<version>2.59.2</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- En Spring Boot 4 el soporte de pruebas tambien se partio por
		     tecnologia: spring-boot-starter-test ya NO trae MockMvc/
		     @AutoConfigureMockMvc (ese paquete migro a
		     org.springframework.boot.webmvc.test.autoconfigure). Sin este
		     modulo, cualquier test que use MockMvc no compila. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Desde el JDK 23 (JEP 'deprecate implicit annotation processing', y
			     efectivo en el 24) javac ya NO ejecuta por su cuenta los annotation
			     processors que encuentra en el classpath. Consecuencia en este
			     proyecto: Lombok deja de correr, @Getter y @Setter no generan nada,
			     y la compilacion falla con ~200 errores 'cannot find symbol' sobre
			     metodos como getUuidPublico() o builder().

			     '-proc:full' devuelve el comportamiento anterior de forma explicita.
			     Se pone aqui, y no como <annotationProcessorPaths> de Lombok, por dos
			     razones: sigue funcionando con el JDK 21 que declara <java.version>,
			     y no fija una version de Lombok distinta de la que ya gobierna el
			     parent de Spring Boot. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<compilerArgs>
						<arg>-proc:full</arg>
					</compilerArgs>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
