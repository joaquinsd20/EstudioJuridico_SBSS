# Plantilla de configuracion para desarrollo.
#
# Copiala como .env.local y rellena los valores:
#     Copy-Item .env.ejemplo .env.local
#
# .env.local esta en el .gitignore y NO debe subirse nunca.
# El script Arrancar.ps1 lee .env.local; si no existe, avisa de que falta.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=lexia_db_sbss
DB_USERNAME=root
DB_PASSWORD=cambia-esto-por-tu-contrasena
# Inteligencia artificial para Escritos con IA (GroqCloud)
# Crea una clave en https://console.groq.com/keys y pegala solo en .env.local
GROQ_API_KEY=
LEXIA_IA_PROVIDER=groq
LEXIA_IA_MODEL=openai/gpt-oss-120b
LEXIA_IA_BASE_URL=https://api.groq.com/openai/v1
