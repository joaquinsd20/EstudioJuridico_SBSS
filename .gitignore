Thumbs.db
Desktop.ini
.DS_Store

# =========================
# ENVIRONMENT / SECRETS
# =========================
# application-local.yml es el archivo que application-dev.yml le recomienda
# al equipo para poner sus credenciales de MySQL. Si deja de estar aqui, la
# primera persona que siga esa recomendacion sube su contrasena al repo.
.env
.env.*
# Salen las plantillas: no traen contrasena y sin ellas nadie sabe que
# variables hay que rellenar.
!.env.ejemplo
!.env.example
!.env.sample
application-local.properties
application-local.yml

# =========================
# LOGS
# =========================
*.log
logs/

