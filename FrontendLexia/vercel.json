{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npx ng build",
  "outputDirectory": "dist/FrontedLexia/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://lexia-backend.onrender.com/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
